# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#   cp .env.example .env
#
# ⚠️  ใช้ token คนละใบกับฝั่ง Builder (~/.line-builder/.env)
#     ถ้าเซิร์ฟเวอร์ตัวนี้โดนเจาะ จะได้ revoke ใบนี้ใบเดียวโดยไม่กระทบเครื่องมือฝั่ง Builder

# Developers Console > channel > Messaging API > Channel access token
CHANNEL_ACCESS_TOKEN=

# Developers Console > channel > Basic settings > Channel secret
# ใช้ตรวจลายเซ็นว่า webhook มาจาก LINE จริง — ขาดไม่ได้
CHANNEL_SECRET=

# kie.ai — ใช้สร้างรูปสินค้าให้ลูกค้า (ดู context.md ข้อ 6)
# ห้ามใส่ค่าจริงในไฟล์นี้ ใส่ใน .env เท่านั้น (.env ถูก gitignore ไว้แล้ว)
# ใช้เฉพาะตอนรัน `npm run gen:images` — ตัวบอทตอนรับลูกค้าไม่ต้องใช้ key นี้
KIE_API_KEY=

# โดเมน HTTPS ที่ลูกค้าเข้าถึงเซิร์ฟเวอร์นี้ได้จริง (ไม่ต้องมี / ปิดท้าย)
# LINE จะมาโหลดรูปสินค้าจาก <PUBLIC_BASE_URL>/images/*.jpg เอง
# ต้องเป็น https เท่านั้น (LINE บังคับ TLS 1.2+) — ตอนเทสใช้ URL ของ ngrok ได้
#
# ⚠️ ไม่ตั้งค่านี้ = โหมดส่งรูปปิด ลูกค้าขอดูรูปจะได้แต่ข้อความสำรอง (เคยพลาดมาแล้ว ดู README)
# วิธีที่ง่ายที่สุดถ้ายังไม่มี host: ชี้ไปที่ GitHub raw ของ repo นี้ (repo เป็น public อยู่แล้ว)
#   PUBLIC_BASE_URL=https://raw.githubusercontent.com/<user>/<repo>/main/public
PUBLIC_BASE_URL=

# (ไม่บังคับ) LINE userId ของแอดมิน — ถ้าตั้งไว้ บอทจะ push แจ้งเตือนเมื่อมีเคสที่ต้องให้คนรับช่วง
# ⚠️ push กินโควตาข้อความรายเดือน ต่างจาก reply ที่ไม่กิน ถ้าไม่ตั้งจะแค่ขึ้น log ฝั่งเซิร์ฟเวอร์
ADMIN_USER_ID=

PORT=3000
