# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#   cp .env.example .env
#
# ⚠️  ใช้ token คนละใบกับฝั่ง Builder (~/.line-builder/.env)
#     ถ้าเซิร์ฟเวอร์ตัวนี้โดนเจาะ จะได้ revoke ใบนี้ใบเดียวโดยไม่กระทบเครื่องมือฝั่ง Builder

# Developers Console > channel > Messaging API > Channel access token
CHANNEL_ACCESS_TOKEN=

# Developers Console > channel > Basic settings > Channel secret
# ใช้ตรวจลายเซ็นว่า webhook มาจาก LINE จริง — ขาดไม่ได้
CHANNEL_SECRET=

# kie.ai — ใช้สร้างรูปสินค้าให้ลูกค้า (ดู context.md ข้อ 6)
# ห้ามใส่ค่าจริงในไฟล์นี้ ใส่ใน .env เท่านั้น (.env ถูก gitignore ไว้แล้ว)
# ใช้เฉพาะตอนรัน `npm run gen:images` — ตัวบอทตอนรับลูกค้าไม่ต้องใช้ key นี้
KIE_API_KEY=

# โดเมน HTTPS ที่ลูกค้าเข้าถึงเซิร์ฟเวอร์นี้ได้จริง (ไม่ต้องมี / ปิดท้าย)
# LINE จะมาโหลดรูปสินค้าจาก <PUBLIC_BASE_URL>/images/*.jpg เอง
# ต้องเป็น https เท่านั้น (LINE บังคับ TLS 1.2+) — ตอนเทสใช้ URL ของ ngrok ได้
#
# ⚠️ ไม่ตั้งค่านี้ = โหมดส่งรูปปิด ลูกค้าขอดูรูปจะได้แต่ข้อความสำรอง (เคยพลาดมาแล้ว ดู README)
# วิธีที่ง่ายที่สุดถ้ายังไม่มี host: ชี้ไปที่ GitHub raw ของ repo นี้ (repo เป็น public อยู่แล้ว)
#   PUBLIC_BASE_URL=https://raw.githubusercontent.com/<user>/<repo>/main/public
PUBLIC_BASE_URL=

# (ไม่บังคับ · ของเดิม) LINE userId ของแอดมิน
#
# ⚠️ ปกติ "ไม่ต้องตั้ง" — สิทธิ์ผู้ดูแลได้มาจากการ claim ด้วยรหัสใช้ครั้งเดียวแทนแล้ว
#     ออกรหัสด้วย: node scripts/admin-tool.mjs issue  แล้วพิมพ์รหัสนั้นในแชท
#
# ค่านี้ให้สิทธิ์ "สั่งงาน" อย่างเดียว ไม่ได้ทำให้รายงาน 4 งานวิ่งไปหา
# รายงานไปหาคนที่ claim เท่านั้น (ก่อน claim จะเก็บเข้าคิวไว้ก่อน — ดู README)
ADMIN_USER_ID=

# OpenRouter — สมองร้าน ใช้ตอบคำถามปลายเปิดที่กฎตายตัวใน reply.js ตอบไม่ได้
# (เช่น "ร้านอะไร มีโปรอะไรบ้าง ส่งยังไง") อ่าน context.md + products.md +
# promotions.md เป็น system prompt — เรื่องรูปไม่ผ่านสมอง กฎตายตัวจัดการเองก่อนแล้ว
#
# ไม่ตั้งค่านี้ก็ยังใช้งานได้ แต่คำถามปลายเปิดจะส่งต่อแอดมินทั้งหมดเหมือนเดิม
OPENROUTER_API_KEY=

# (ไม่บังคับ) เปลี่ยนรุ่นโมเดลได้ ค่าเริ่มต้นคือ openai/gpt-5.6-luna
OPENROUTER_MODEL=

# (ไม่บังคับ) รอให้ลูกค้าพิมพ์จบกี่มิลลิวินาทีก่อนตอบ ค่าเริ่มต้น 30000 (30 วินาที)
# ลูกค้ามักพิมพ์ทีละบับเบิลสั้น ๆ ต่อกัน ตอบทันทีจะตอบผิดบริบท
# นาฬิกาเริ่มนับใหม่ทุกครั้งที่มีบับเบิลใหม่ — ลูกค้าหยุดพิมพ์เมื่อไหร่จึงตอบ
#
# ⚠️ ยิ่งยาวยิ่งเสี่ยงกับอายุ reply token ของ LINE (quiet window + เวลาที่สมองร้านคิด)
#    ถ้าเจอว่าลูกค้าได้ข้อความ "เมื่อครู่ส่งไม่ออก" บ่อย ให้ลดค่านี้ลง
REPLY_DELAY_MS=

# (ไม่บังคับ) เพดานรวมตั้งแต่บับเบิลแรก ค่าเริ่มต้น 60000 (60 วินาที)
# ลูกค้าที่พิมพ์รัวไม่หยุดต้องได้คำตอบสักที ไม่ใช่รอไปเรื่อย ๆ
REPLY_MAX_WAIT_MS=

# (ไม่บังคับ) เวลาส่งรายงานเย็น เวลาไทย ค่าเริ่มต้น 18:30
EVENING_REPORT_AT=

# (ไม่บังคับ · ห้ามตั้งบน production) เปิดตัวจำลองความพังสำหรับ Customer Test
# ตั้งเป็น 1 เท่านั้นถึงจะสั่ง admin-tool.mjs fault <ชื่อ> ได้
# ต่อให้ตั้งไว้ ถ้ามีแอดมิน claim สิทธิ์แล้วก็ยังเปิดไม่ได้อยู่ดี
ALLOW_FAULT_INJECTION=

PORT=3000

# ---------------------------------------------------------
#  Card Studio & Quote Engine
# ---------------------------------------------------------

# ห้องคำสั่งของเจ้าของร้าน (admin lane)
# ตั้งเป็น groupId ของกลุ่มทีมงาน ถ้าอยากสั่งจากกลุ่มแทนแชท 1:1 กับ ADMIN_USER_ID
# ไม่ตั้ง = admin lane มีแค่แชท 1:1 กับ ADMIN_USER_ID
# ⚠️ ห้ามตั้งเป็นกลุ่มที่มีลูกค้าอยู่ด้วย — ทุกคนในกลุ่มจะสั่งอนุมัติใบเสนอราคาได้
ADMIN_GROUP_ID=

# ที่เก็บธุรกรรมจริง — ค่าเริ่มต้นคือ ~/shop-data (โฟลเดอร์ 700 · ไฟล์ 600)
# ⚠️ ห้ามชี้มาที่โฟลเดอร์ของ repo เด็ดขาด repo นี้เป็น public
SHOP_DATA_DIR=

# ---------------------------------------------------------
#  ช่องทางรับเงิน  ⚠️  ข้อมูลการเงิน — ใส่ค่าจริงใน .env เท่านั้น
# ---------------------------------------------------------
#
# ⚠️  ทั้งสองค่าข้างล่างนี้ระบบอ่านจาก ENV "เท่านั้น"
#     ไม่อ่านจาก context.md · ไม่อ่านจาก products.md · ไม่รับจากข้อความในแชท
#     ไม่ตั้ง = บอทไม่แจ้งช่องทางชำระเงินเอง แต่ส่งต่อให้แอดมินแจ้ง (ปลอดภัยกว่าเดาเลขบัญชี)
#     ห้ามใส่ค่าจริงในไฟล์ .env.example นี้เด็ดขาด — repo นี้เป็น public

# ชื่อผู้รับเงินที่ลูกค้าจะเห็นบนการ์ดและตอนสแกน QR
# ต้องตรงกับชื่อบัญชีจริง ไม่งั้นลูกค้าจะลังเลตอนเห็นชื่อในแอปธนาคารแล้วไม่ตรงกับที่ร้านบอก
PAYMENT_ACCOUNT_NAME=

# ช่องทางรับเงินทั้งหมด เป็น JSON array บรรทัดเดียว
#
#   id      คีย์สั้น ๆ (a-z 0-9 _ -) ใช้อ้างอิงในปุ่มบนการ์ด — ห้ามซ้ำกัน
#   type    "promptpay" (ออก QR ได้) หรือ "bank" (โอนด้วยเลขบัญชีอย่างเดียว)
#   label   ชื่อที่ลูกค้าเห็น เช่น "พร้อมเพย์" "กสิกรไทย"
#   number  เลขพร้อมเพย์ / เลขบัญชี (ใส่ขีดได้)
#   account_name  (ไม่บังคับ) ถ้าบัญชีนี้ชื่อไม่ตรงกับ PAYMENT_ACCOUNT_NAME
#
# ตัวอย่างรูปแบบ (เลขข้างล่างเป็นตัวอย่าง ไม่ใช่ของจริง):
#   PAYMENT_DESTINATIONS_JSON=[{"id":"pp","type":"promptpay","label":"พร้อมเพย์","number":"0XXXXXXXXX"},{"id":"kbank","type":"bank","label":"กสิกรไทย","number":"XXX-X-XXXXX-X"}]
#
# ⚠️ ต้องเป็นบรรทัดเดียว — ตัวอ่าน .env (src/env.js) อ่านทีละบรรทัด
PAYMENT_DESTINATIONS_JSON=

# (ของเดิม) เลขพร้อมเพย์ช่องทางเดียว — ใช้ได้ต่อถ้ายังไม่ได้ย้ายไป PAYMENT_DESTINATIONS_JSON
# ถ้าตั้ง PAYMENT_DESTINATIONS_JSON แล้ว ค่านี้จะถูกมองข้าม
PROMPTPAY_ID=

# นโยบายใบเสนอราคา — ไม่ตั้ง (หรือตั้งค่าที่ไม่ใช่ตัวเลข) จะใช้ค่าเริ่มต้นในวงเล็บ
# ⚠️ ห้ามเขียนคอมเมนต์ท้ายบรรทัดค่า — ตัวอ่าน .env (src/env.js) จะเก็บคอมเมนต์ไปเป็นค่าด้วย

# ส่วนลดที่บอทตัดสินใจเองได้ เป็น % (ค่าเริ่มต้น 5)
QUOTE_DISCOUNT_CAP=

# ยอดสุทธิที่เกินแล้วต้องรอเจ้าของร้าน เป็นบาท (ค่าเริ่มต้น 50000)
QUOTE_HIGH_VALUE=

# มัดจำ เป็น % (ค่าเริ่มต้น 50)
QUOTE_DEPOSIT_PERCENT=

# อายุใบเสนอราคา เป็นวัน (ค่าเริ่มต้น 3)
# ใบที่เลยกำหนดนี้จะกลายเป็น "หมดอายุ" ทันทีที่มีคนแตะ และ "ห้ามออก QR" เด็ดขาด
QUOTE_VALID_DAYS=
