# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#   cp .env.example .env
#
# ⚠️  ใช้ token คนละใบกับฝั่ง Builder (~/.line-builder/.env)
#     ถ้าเซิร์ฟเวอร์ตัวนี้โดนเจาะ จะได้ revoke ใบนี้ใบเดียวโดยไม่กระทบเครื่องมือฝั่ง Builder

# Developers Console > channel > Messaging API > Channel access token
CHANNEL_ACCESS_TOKEN=

# Developers Console > channel > Basic settings > Channel secret
# ใช้ตรวจลายเซ็นว่า webhook มาจาก LINE จริง — ขาดไม่ได้
CHANNEL_SECRET=

# kie.ai — ใช้สร้างรูปสินค้าให้ลูกค้า (ดู context.md ข้อ 6)
# ห้ามใส่ค่าจริงในไฟล์นี้ ใส่ใน .env เท่านั้น (.env ถูก gitignore ไว้แล้ว)
KIE_API_KEY=

PORT=3000
