# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)
#   cp .env.example .env
#
# ⚠️  ใช้ token คนละใบกับฝั่ง Builder (~/.line-builder/.env)
#     ถ้าเซิร์ฟเวอร์ตัวนี้โดนเจาะ จะได้ revoke ใบนี้ใบเดียวโดยไม่กระทบเครื่องมือฝั่ง Builder

# Developers Console > channel > Messaging API > Channel access token
CHANNEL_ACCESS_TOKEN=

# Developers Console > channel > Basic settings > Channel secret
# ใช้ตรวจลายเซ็นว่า webhook มาจาก LINE จริง — ขาดไม่ได้
CHANNEL_SECRET=

# kie.ai — ใช้สร้างรูปสินค้าให้ลูกค้า (ดู context.md ข้อ 6)
# ห้ามใส่ค่าจริงในไฟล์นี้ ใส่ใน .env เท่านั้น (.env ถูก gitignore ไว้แล้ว)
# ใช้เฉพาะตอนรัน `npm run gen:images` — ตัวบอทตอนรับลูกค้าไม่ต้องใช้ key นี้
KIE_API_KEY=

# โดเมน HTTPS ที่ลูกค้าเข้าถึงเซิร์ฟเวอร์นี้ได้จริง (ไม่ต้องมี / ปิดท้าย)
# LINE จะมาโหลดรูปสินค้าจาก <PUBLIC_BASE_URL>/images/*.jpg เอง
# ต้องเป็น https เท่านั้น (LINE บังคับ TLS 1.2+) — ตอนเทสใช้ URL ของ ngrok ได้
#
# ⚠️ ไม่ตั้งค่านี้ = โหมดส่งรูปปิด ลูกค้าขอดูรูปจะได้แต่ข้อความสำรอง (เคยพลาดมาแล้ว ดู README)
# วิธีที่ง่ายที่สุดถ้ายังไม่มี host: ชี้ไปที่ GitHub raw ของ repo นี้ (repo เป็น public อยู่แล้ว)
#   PUBLIC_BASE_URL=https://raw.githubusercontent.com/<user>/<repo>/main/public
PUBLIC_BASE_URL=

# (ไม่บังคับ) LINE userId ของแอดมิน — ถ้าตั้งไว้ บอทจะ push แจ้งเตือนเมื่อมีเคสที่ต้องให้คนรับช่วง
# ⚠️ push กินโควตาข้อความรายเดือน ต่างจาก reply ที่ไม่กิน ถ้าไม่ตั้งจะแค่ขึ้น log ฝั่งเซิร์ฟเวอร์
ADMIN_USER_ID=

# OpenRouter — สมองร้าน ใช้ตอบคำถามปลายเปิดที่กฎตายตัวใน reply.js ตอบไม่ได้
# (เช่น "ร้านอะไร มีโปรอะไรบ้าง ส่งยังไง") อ่าน context.md + products.md +
# promotions.md เป็น system prompt — เรื่องรูปไม่ผ่านสมอง กฎตายตัวจัดการเองก่อนแล้ว
#
# ไม่ตั้งค่านี้ก็ยังใช้งานได้ แต่คำถามปลายเปิดจะส่งต่อแอดมินทั้งหมดเหมือนเดิม
OPENROUTER_API_KEY=

# (ไม่บังคับ) เปลี่ยนรุ่นโมเดลได้ ค่าเริ่มต้นคือ openai/gpt-5.6-luna
OPENROUTER_MODEL=

# (ไม่บังคับ) รอให้ลูกค้าพิมพ์จบกี่มิลลิวินาทีก่อนตอบ ค่าเริ่มต้น 7000 (7 วินาที)
# ลูกค้ามักพิมพ์ทีละบับเบิลสั้น ๆ ต่อกัน ตอบทันทีจะตอบผิดบริบท
# นาฬิกาเริ่มนับใหม่ทุกครั้งที่มีบับเบิลใหม่ — ลูกค้าหยุดพิมพ์เมื่อไหร่จึงตอบ
REPLY_DELAY_MS=

PORT=3000

# ---------------------------------------------------------
#  Card Studio & Quote Engine
# ---------------------------------------------------------

# ห้องคำสั่งของเจ้าของร้าน (admin lane)
# ตั้งเป็น groupId ของกลุ่มทีมงาน ถ้าอยากสั่งจากกลุ่มแทนแชท 1:1 กับ ADMIN_USER_ID
# ไม่ตั้ง = admin lane มีแค่แชท 1:1 กับ ADMIN_USER_ID
# ⚠️ ห้ามตั้งเป็นกลุ่มที่มีลูกค้าอยู่ด้วย — ทุกคนในกลุ่มจะสั่งอนุมัติใบเสนอราคาได้
ADMIN_GROUP_ID=

# ที่เก็บธุรกรรมจริง — ค่าเริ่มต้นคือ ~/shop-data (โฟลเดอร์ 700 · ไฟล์ 600)
# ⚠️ ห้ามชี้มาที่โฟลเดอร์ของ repo เด็ดขาด repo นี้เป็น public
SHOP_DATA_DIR=

# เลขพร้อมเพย์ที่ใช้รับเงิน — ไม่ตั้งจะไปอ่านจาก context.md ข้อ 7
# ไม่มีทั้งสองทาง = บอทไม่แจ้งช่องทางชำระเงินเอง แต่ส่งต่อให้แอดมินแจ้ง
PROMPTPAY_ID=

# นโยบายใบเสนอราคา — ไม่ตั้ง (หรือตั้งค่าที่ไม่ใช่ตัวเลข) จะใช้ค่าเริ่มต้นในวงเล็บ
# ⚠️ ห้ามเขียนคอมเมนต์ท้ายบรรทัดค่า — ตัวอ่าน .env (src/env.js) จะเก็บคอมเมนต์ไปเป็นค่าด้วย

# ส่วนลดที่บอทตัดสินใจเองได้ เป็น % (ค่าเริ่มต้น 5)
QUOTE_DISCOUNT_CAP=

# ยอดสุทธิที่เกินแล้วต้องรอเจ้าของร้าน เป็นบาท (ค่าเริ่มต้น 50000)
QUOTE_HIGH_VALUE=

# มัดจำ เป็น % (ค่าเริ่มต้น 50)
QUOTE_DEPOSIT_PERCENT=

# อายุใบเสนอราคา เป็นวัน (ค่าเริ่มต้น 7)
QUOTE_VALID_DAYS=
